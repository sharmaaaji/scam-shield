{
  "manifest_version": 3,
  "name": "ScamShield",
  "version": "0.2.0",
  "description": "Flags likely scam and phishing messages in Gmail and WhatsApp Web. Runs on-device by default — your messages are never sent to us.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": [
        "shared/triage.js",
        "shared/classifier.js",
        "shared/scanner.js",
        "content-gmail.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "shared/triage.js",
        "shared/classifier.js",
        "shared/scanner.js",
        "content-whatsapp.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamShield"
  }
}
